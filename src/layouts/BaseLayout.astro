---
import { SITE, SOCIAL } from '../lib/constants';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/retro.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, any>;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = '/images/og-default.png',
  ogType = 'website',
  jsonLd,
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'lawpeeps.ai',
  url: SITE.url,
  logo: `${SITE.url}/images/logo-pink.png`,
  description: SITE.description,
  sameAs: [SOCIAL.twitter, SOCIAL.linkedin, SOCIAL.bluesky],
  founder: {
    '@type': 'Person',
    name: 'Chris Dias',
  },
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  publisher: { '@type': 'Organization', name: 'lawpeeps.ai' },
};
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE.author} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1456" />
  <meta property="og:image:height" content="816" />
  <meta property="og:image:alt" content={`${SITE.title} - ${title}`} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:locale" content="en_GB" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@lawpeepsai" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={`${SITE.title} - ${title}`} />

  <!-- Structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />

  <script>
    // Dark mode toggle
    const toggle = document.getElementById('theme-toggle');
    if (toggle) {
      const saved = localStorage.getItem('theme');
      if (saved) {
        document.documentElement.setAttribute('data-theme', saved);
      }
      toggle.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    }
  </script>
</body>
</html>
