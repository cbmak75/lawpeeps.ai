---
import { DISCLAIMER, SOCIAL, SITE } from '../lib/constants';
import GlassesDivider from './GlassesDivider.astro';
---
<footer class="site-footer pixel-grid">
  <div class="container">
    <GlassesDivider />

    <div class="footer-grid">
      <div class="footer-disclaimer">
        <p class="disclaimer-text">{DISCLAIMER}</p>
      </div>

      <div class="footer-links">
        <h4>lawpeeps.ai</h4>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/editorial-charter">Editorial charter</a></li>
          <li><a href="/tip-line">Tip line</a></li>
          <li><a href="/rss.xml">RSS feed</a></li>
        </ul>
      </div>

      <div class="footer-social">
        <h4>Find mm!ke</h4>
        <ul>
          <li><a href={SOCIAL.twitter} target="_blank" rel="noopener noreferrer">Twitter / X</a></li>
          <li><a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={SOCIAL.bluesky} target="_blank" rel="noopener noreferrer">Bluesky</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>A project of <a href="https://legalaid.dev" target="_blank" rel="noopener noreferrer">Legalaid Ltd</a></p>
      <p class="copyright">{new Date().getFullYear()} {SITE.title}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--black);
    color: rgba(255, 255, 255, 0.7);
    padding: var(--space-xl) 0 var(--space-2xl);
    margin-top: var(--space-4xl);
  }

  .site-footer :global(.divider-glasses) {
    opacity: 0.15;
    margin-bottom: var(--space-2xl);
  }

  .site-footer :global(.divider-glasses svg) {
    stroke: var(--white);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .disclaimer-text {
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
    max-width: 480px;
    opacity: 0.6;
    font-style: italic;
  }

  h4 {
    color: var(--white);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-md);
  }

  ul {
    list-style: none;
  }

  li {
    margin-bottom: var(--space-sm);
  }

  .site-footer a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color 0.15s ease;
  }

  .site-footer a:hover {
    color: var(--pink);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-xs);
    opacity: 0.5;
  }

  .footer-bottom a {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
