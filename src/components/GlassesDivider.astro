---
// Simplified glasses silhouette used as a section divider
---
<div class="divider-glasses" aria-hidden="true">
  <svg viewBox="0 0 120 50" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- Left lens -->
    <rect x="4" y="8" width="48" height="32" rx="8" />
    <!-- Right lens -->
    <rect x="68" y="8" width="48" height="32" rx="8" />
    <!-- Bridge -->
    <path d="M52 20 C56 14, 64 14, 68 20" />
    <!-- Left arm -->
    <line x1="4" y1="16" x2="0" y2="12" />
    <!-- Right arm -->
    <line x1="116" y1="16" x2="120" y2="12" />
  </svg>
</div>
