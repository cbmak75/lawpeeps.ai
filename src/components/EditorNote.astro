---
interface Props {
  note: string;
}

const { note } = Astro.props;
---
<aside class="editor-note content-width">
  <p><em>{note}</em></p>
</aside>

<style>
  .editor-note {
    font-size: var(--text-sm);
    color: var(--colour-caption);
    padding: var(--space-md) 0;
    line-height: var(--leading-loose);
  }
</style>
