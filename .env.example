# lawpeeps.ai environment variables
# Copy this to .env and fill in the values

# Gemini API (for agentic layer -- powers mm!ke's editorial intelligence)
# Free tier key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=

# Optional model overrides (defaults: flash-lite for triage, flash for
# editor and verifier). Verify current model names in AI Studio.
# GEMINI_MODEL_TRIAGE=
# GEMINI_MODEL_EDITOR=
# GEMINI_MODEL_VERIFIER=

# GitHub (for content commits and PR creation from agentic layer)
GITHUB_TOKEN=

# Netlify (for tip line form submissions)
NETLIFY_FORMS_TOKEN=
NETLIFY_SITE_ID=

# Newsletter (Buttondown)
BUTTONDOWN_API_KEY=

# Social media
TWITTER_API_KEY=
TWITTER_API_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Analytics (Plausible)
PLAUSIBLE_DOMAIN=lawpeeps.ai
