# lawpeeps.ai environment variables
# Copy this to .env and fill in the values

# Claude API (for agentic layer -- powers mm!ke's editorial intelligence)
ANTHROPIC_API_KEY=

# GitHub (for content commits and PR creation from agentic layer)
GITHUB_TOKEN=

# Netlify (for tip line form submissions)
NETLIFY_FORMS_TOKEN=
NETLIFY_SITE_ID=

# Newsletter (Buttondown)
BUTTONDOWN_API_KEY=

# Social media
TWITTER_API_KEY=
TWITTER_API_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Analytics (Plausible)
PLAUSIBLE_DOMAIN=lawpeeps.ai
